import { OutputPass } from 'three/addons/postprocessing/OutputPass.js';

/* ---------- data ---------- */
const RAW = JSON.parse(document.getElementById('data').textContent);
const K = RAW.keys;
const C = RAW.rows.map((r,i)=>{const o={i}; K.forEach((k,j)=>o[k]=r[j]); return o;});
const FAM = RAW.families, P2F = RAW.p2f;
const COL = {direct:'#5cc8ff', split:'#c79bff', elective:'#ffb547', dev:'#ff7a9c'};
const MLABEL = {direct:'Direct match', split:'Two Kean courses', elective:'Elective credit'};
const MORDER = ['direct','split','elective'];
const LV = {UG:'Undergraduate', GR:'Graduate', DR:'Doctoral'};
const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
const fmt = n => n.toLocaleString('en-US');
const pct = (a,b) => b ? (100*a/b) : 0;
const esc = s => String(s??'').replace(/[&<>"]/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const kSub = code => String(code||'').split('*')[0];

function agg(list){
  const a={n:list.length, m:{direct:0,split:0,elective:0}, lv:{UG:0,GR:0,DR:0}, dev:0, gain:0, njcuCr:0, keanCr:0, codes:new Set(), dest:{}, subs:{}};
  for(const c of list){
    a.m[c.m]++; a.lv[c.lv]=(a.lv[c.lv]||0)+1; if(c.ct==='TD')a.dev++; if(c.diff>0)a.gain++;
    a.njcuCr+= +c.cr||0; a.keanCr+=(+c.kc1||0)+(+c.kc2||0); a.codes.add(c.c);
    for(const k of [c.k1,c.k2]) if(k){const s=kSub(k); a.dest[s]=(a.dest[s]||0)+1;}
    a.subs[c.p]=(a.subs[c.p]||0)+1;
  }
  return a;
}
const ALL = agg(C);
const bySub = {}; C.forEach(c=>(bySub[c.p] ||= []).push(c));
const byFam = {}; C.forEach(c=>(byFam[P2F[c.p]] ||= []).push(c));
const SUBS = Object.keys(bySub);

/* ---------- three setup ---------- */
const stage = document.getElementById('stage');
const renderer = new THREE.WebGLRenderer({antialias:true, powerPreference:'high-performance'});
renderer.setPixelRatio(Math.min(devicePixelRatio,2));
renderer.setSize(innerWidth, innerHeight);
renderer.toneMapping = THREE.ACESFilmicToneMapping;
renderer.toneMappingExposure = 1.05;
stage.appendChild(renderer.domElement);

const scene = new THREE.Scene();
scene.background = new THREE.Color('#060a17');
scene.fog = new THREE.FogExp2('#060a17', 0.0062);
const camera = new THREE.PerspectiveCamera(48, innerWidth/innerHeight, 0.1, 1200);
const HOME = {pos:new THREE.Vector3(0,58,96), tgt:new THREE.Vector3(0,2,0)};
camera.position.set(0,190,260);
const controls = new OrbitControls(camera, renderer.domElement);
controls.enableDamping = true; controls.dampingFactor = .07;
controls.minDistance = 10; controls.maxDistance = 260; controls.maxPolarAngle = Math.PI*0.49;
controls.target.copy(HOME.tgt);

scene.add(new THREE.HemisphereLight('#9fb6ff','#1a1030',0.9));
const sun = new THREE.DirectionalLight('#ffffff',1.4); sun.position.set(40,80,30); scene.add(sun);
const rim = new THREE.DirectionalLight('#7aa8ff',0.8); rim.position.set(-60,20,-50); scene.add(rim);

const composer = new EffectComposer(renderer);
composer.addPass(new RenderPass(scene,camera));
const bloom = new UnrealBloomPass(new THREE.Vector2(innerWidth,innerHeight), 0.7, 0.5, 0.8);
composer.addPass(bloom);
composer.addPass(new OutputPass());

/* stars */
{
  const n=1800, g=new THREE.BufferGeometry(), p=new Float32Array(n*3);
  for(let i=0;i<n;i++){const r=260+Math.random()*300, t=Math.random()*Math.PI*2, ph=Math.acos(Math.random()*1.6-0.6);
    p[i*3]=r*Math.sin(ph)*Math.cos(t); p[i*3+1]=r*Math.cos(ph); p[i*3+2]=r*Math.sin(ph)*Math.sin(t);}
  g.setAttribute('position',new THREE.BufferAttribute(p,3));
  var stars = new THREE.Points(g,new THREE.PointsMaterial({color:'#c9d6ff',size:1.3,sizeAttenuation:true,transparent:true,opacity:.75,fog:false}));
  scene.add(stars);
}
/* polar grid floor */
{
  const grid = new THREE.PolarGridHelper(120, 24, 10, 96, '#24305a', '#151d3a');
  grid.position.y = -14; grid.material.transparent=true; grid.material.opacity=.55; scene.add(grid);
}

function dotTexture(){
  const c=document.createElement('canvas'); c.width=c.height=64; const x=c.getContext('2d');
  const g=x.createRadialGradient(32,32,0,32,32,32); g.addColorStop(0,'rgba(255,255,255,1)'); g.addColorStop(.35,'rgba(255,255,255,.6)'); g.addColorStop(1,'rgba(255,255,255,0)');
  x.fillStyle=g; x.fillRect(0,0,64,64); return new THREE.CanvasTexture(c);
}
const DOT = dotTexture();

function textSprite(text, color='#eef2ff', size=40){
  const c=document.createElement('canvas'); const x=c.getContext('2d');
  x.font=`700 ${size}px "JetBrains Mono", monospace`; const w=Math.ceil(x.measureText(text).width)+24;
  c.width=w; c.height=size+20; x.font=`700 ${size}px "JetBrains Mono", monospace`;
  x.fillStyle=color; x.textBaseline='middle'; x.shadowColor='rgba(0,0,0,.9)'; x.shadowBlur=8; x.fillText(text,12,c.height/2);
  const t=new THREE.CanvasTexture(c); t.colorSpace=THREE.SRGBColorSpace; t.anisotropy=4;
  const s=new THREE.Sprite(new THREE.SpriteMaterial({map:t,transparent:true,depthWrite:false,fog:false}));
  const h=0.62; s.scale.set(h*c.width/c.height,h,1); return s;
}

/* ---------- world objects ---------- */
const pickables = [];
const towers = {};      // subject -> {group, segs, label, island, height}
const islands = [];     // {name, group, base, radius, labelEl}

/* Kean core */
const core = new THREE.Group(); scene.add(core);
const coreMat = new THREE.MeshStandardMaterial({color:'#123a6b', emissive:'#2f8cff', emissiveIntensity:1.1, metalness:.3, roughness:.25, flatShading:true});
const coreMesh = new THREE.Mesh(new THREE.IcosahedronGeometry(4.2,1), coreMat);
coreMesh.userData={kind:'core'}; core.add(coreMesh); pickables.push(coreMesh);
const coreShell = new THREE.Mesh(new THREE.IcosahedronGeometry(5.6,1), new THREE.MeshBasicMaterial({color:'#5cc8ff',wireframe:true,transparent:true,opacity:.22}));
core.add(coreShell);
const coreLabel = textSprite('KEAN','#ffffff',56); coreLabel.position.set(0,8.2,0); coreLabel.scale.multiplyScalar(2.2); core.add(coreLabel);
core.position.y = 4;

/* level rings */
const rings = [];
[['UG',8.5,'#5cc8ff'],['GR',11,'#9fb4ff'],['DR',13.5,'#ff7a9c']].forEach(([lv,r,col],i)=>{
  const share = ALL.lv[lv]/ALL.n;
  const tube = 0.09 + share*0.45;
  const m = new THREE.Mesh(new THREE.TorusGeometry(r,tube,12,160), new THREE.MeshStandardMaterial({color:col, emissive:col, emissiveIntensity:.8, transparent:true, opacity:.85, roughness:.3}));
  m.rotation.x = Math.PI/2 + (i-1)*0.32; m.rotation.y = (i-1)*0.25;
  m.userData={kind:'level', id:lv, baseEI:.8};
  core.add(m); pickables.push(m); rings.push(m);
  // invisible fat hit-tube for easier clicking
  const hit = new THREE.Mesh(new THREE.TorusGeometry(r,1.1,6,60), new THREE.MeshBasicMaterial({visible:false}));
  hit.rotation.copy(m.rotation); hit.userData={kind:'level', id:lv, proxy:m}; core.add(hit); pickables.push(hit);
  m.userData.hit = hit;
});

/* islands + towers */
const R = 40, SP = 2.25;
const famOrder = [...FAM].sort((a,b)=>byFam[b].length-byFam[a].length);
// interleave big and small so the ring feels balanced
const ring = []; { const a=[...famOrder]; while(a.length){ ring.push(a.shift()); if(a.length) ring.push(a.pop()); } }
const labelsEl = document.getElementById('labels');
const towerMats = {}; MORDER.forEach(m=> towerMats[m]=null);
const hexGeo = new THREE.CylinderGeometry(0.82,0.82,1,6,1); hexGeo.translate(0,0.5,0);

ring.forEach((fam,idx)=>{
  const subs = SUBS.filter(s=>P2F[s]===fam).sort((a,b)=>bySub[b].length-bySub[a].length);
  const rad = SP*Math.sqrt(subs.length)+2.6;
  const ang = idx/ring.length*Math.PI*2 - Math.PI/2;
  const base = new THREE.Vector3(Math.cos(ang)*R, (idx%2? 1.5 : -1.5), Math.sin(ang)*R);
  const g = new THREE.Group(); g.position.copy(base); scene.add(g);

  const top = new THREE.Mesh(new THREE.CylinderGeometry(rad,rad*.94,1.1,7,1), new THREE.MeshStandardMaterial({color:'#1e2a4f', roughness:.85, metalness:.05, flatShading:true}));
  top.position.y=-0.55; top.rotation.y = idx; top.userData={kind:'island', id:fam}; g.add(top); pickables.push(top);
  const under = new THREE.Mesh(new THREE.ConeGeometry(rad*.93, rad*1.15, 7, 3), new THREE.MeshStandardMaterial({color:'#121a35', roughness:1, flatShading:true}));
  under.rotation.x=Math.PI; under.rotation.y=idx; under.position.y=-1.1-rad*1.15/2; under.userData={kind:'island', id:fam}; g.add(under); pickables.push(under);
  // jitter cone vertices for a rocky underside
  { const p=under.geometry.attributes.position; for(let i=0;i<p.count;i++){ if(p.getY(i)<rad*.5){ p.setX(i,p.getX(i)*(0.85+Math.random()*.3)); p.setZ(i,p.getZ(i)*(0.85+Math.random()*.3)); } } under.geometry.computeVertexNormals(); }
  const edge = new THREE.Mesh(new THREE.TorusGeometry(rad*.985,0.07,6,7), new THREE.MeshBasicMaterial({color:'#8fb2ff',transparent:true,opacity:.55}));
  edge.rotation.x=Math.PI/2; edge.rotation.z=idx; edge.position.y=0.01; g.add(edge);

  const isl = {name:fam, group:g, base, radius:rad, top, edge, subs, phase:idx*0.9};
  islands.push(isl);

  subs.forEach((s,i)=>{
    const r = i===0 ? 0 : SP*Math.sqrt(i+0.15);
    const a = i*2.39996 + idx;
    const tg = new THREE.Group(); tg.position.set(Math.cos(a)*r,0,Math.sin(a)*r); g.add(tg);
    const st = agg(bySub[s]);
    const H = 0.8 + Math.pow(st.n,0.8)*0.17;
    let y=0; const segs=[];
    MORDER.forEach(m=>{
      if(!st.m[m]) return;
      const h = H*st.m[m]/st.n;
      const mat = new THREE.MeshStandardMaterial({color:COL[m], emissive:COL[m], emissiveIntensity:.32, roughness:.35, metalness:.15, flatShading:true});
      const mesh = new THREE.Mesh(hexGeo, mat);
      mesh.scale.set(1,h,1); mesh.position.y=y; y+=h;
      mesh.userData={kind:'tower', id:s, seg:m, baseEI:.32};
      tg.add(mesh); pickables.push(mesh); segs.push(mesh);
    });
    // glowing cap
    const cap = new THREE.Mesh(new THREE.CylinderGeometry(0.86,0.86,0.06,6), new THREE.MeshBasicMaterial({color:'#dfe9ff',transparent:true,opacity:.55}));
    cap.position.y=H; cap.userData={kind:'tower', id:s}; tg.add(cap); pickables.push(cap);
    const lab = textSprite(s); lab.position.set(0,H+0.75,0); tg.add(lab);
    tg.scale.y = reduce ? 1 : 0.001;
    towers[s] = {group:tg, segs, cap, label:lab, island:isl, height:H, delay: idx*0.12 + i*0.05, st};
  });

  const el = document.createElement('button'); el.className='isl-label';
  el.innerHTML = `${esc(fam)}<small>${fmt(byFam[fam].length)} courses · ${subs.length} subjects</small>`;
  el.addEventListener('click', ()=>select({kind:'island', id:fam}));
  labelsEl.appendChild(el); isl.labelEl = el;
});

/* streams: particles flowing island -> core */
const streams = []; // per particle
const lineObjs = [];
islands.forEach((isl,ii)=>{
  const list = byFam[isl.name];
  const n = Math.max(6, Math.round(list.length/5));
  for(let k=0;k<n;k++){
    const c = list[Math.floor(Math.random()*list.length)];
    streams.push({isl, t:Math.random(), sp:0.05+Math.random()*0.07, m:c.m, wob:Math.random()*Math.PI*2, off:(Math.random()-.5)*2.2});
  }
  const lg = new THREE.BufferGeometry().setFromPoints(new Array(48).fill(0).map(()=>new THREE.Vector3()));
  const line = new THREE.Line(lg, new THREE.LineBasicMaterial({color:'#4f78c8',transparent:true,opacity:.28}));
  scene.add(line); lineObjs.push({line, isl});
});
const sGeo = new THREE.BufferGeometry();
const sPos = new Float32Array(streams.length*3), sCol = new Float32Array(streams.length*3);
streams.forEach((p,i)=>{const c=new THREE.Color(COL[p.m]); sCol.set([c.r,c.g,c.b],i*3);});
sGeo.setAttribute('position', new THREE.BufferAttribute(sPos,3));
sGeo.setAttribute('color', new THREE.BufferAttribute(sCol,3));
const sMat = new THREE.PointsMaterial({size:1.1, map:DOT, vertexColors:true, transparent:true, depthWrite:false, blending:THREE.AdditiveBlending});
const sPoints = new THREE.Points(sGeo, sMat); scene.add(sPoints);
const _a=new THREE.Vector3(), _b=new THREE.Vector3(), _c=new THREE.Vector3(), _v=new THREE.Vector3();
function bez(isl, t, out, off=0){
  _a.copy(isl.group.position); _a.y += 0.4;
  _c.set(0, core.position.y, 0);
  _b.copy(_a).add(_c).multiplyScalar(.5); _b.y += 16 + off;
  const u=1-t; out.set(u*u*_a.x+2*u*t*_b.x+t*t*_c.x, u*u*_a.y+2*u*t*_b.y+t*t*_c.y, u*u*_a.z+2*u*t*_b.z+t*t*_c.z); return out;
}

/* ---------- interaction ---------- */
const ray = new THREE.Raycaster(); const ptr = new THREE.Vector2();
const tip = document.getElementById('tip');
let hovered = null, selected = null, filterM = null;

function keyOf(o){ return o ? o.kind+':'+o.id : ''; }
function objFromHit(h){ const u=h.object.userData; return u.kind ? {kind:u.kind, id:u.id} : null; }

function setGlow(o, on){
  if(!o) return;
  if(o.kind==='tower'){ const t=towers[o.id]; t.segs.forEach(s=>s.material.emissiveIntensity = on? 0.62 : s.userData.baseEI); t.cap.material.opacity = on? .95:.55; }
  if(o.kind==='island'){ const isl=islands.find(i=>i.name===o.id); isl.edge.material.opacity = on? 1:.55; isl.edge.material.color.set(on?'#ffffff':'#8fb2ff'); }
  if(o.kind==='core'){ coreMat.emissiveIntensity = on? 2.0 : 1.1; }
  if(o.kind==='level'){ const m=rings.find(r=>r.userData.id===o.id); m.material.emissiveIntensity = on? 2.2 : .8; }
}
function tipText(o){
  if(o.kind==='tower'){ const t=towers[o.id].st; return `<b>${o.id}</b> · ${fmt(t.n)} courses · ${pct(t.m.direct,t.n).toFixed(0)}% direct`; }
  if(o.kind==='island') return `<b>${esc(o.id)}</b> · ${fmt(byFam[o.id].length)} courses`;
  if(o.kind==='core') return `<b>KEAN</b> · all ${fmt(ALL.n)} equivalencies`;
  if(o.kind==='level') return `<b>${LV[o.id]}</b> ring · ${fmt(ALL.lv[o.id])} courses`;
}
let downAt=null;
renderer.domElement.addEventListener('pointerdown', e=>{ downAt=[e.clientX,e.clientY]; stopTour(); });
renderer.domElement.addEventListener('pointermove', e=>{
  ptr.set(e.clientX/innerWidth*2-1, -(e.clientY/innerHeight)*2+1);
  ray.setFromCamera(ptr,camera);
  const h = ray.intersectObjects(pickables,false)[0];
  const o = h ? objFromHit(h) : null;
  if(keyOf(o)!==keyOf(hovered)){
    if(hovered && keyOf(hovered)!==keyOf(selected)) setGlow(hovered,false);
    hovered=o; if(o) setGlow(o,true);
  }
  renderer.domElement.style.cursor = o ? 'pointer' : 'grab';
  if(o && e.pointerType==='mouse'){ tip.hidden=false; tip.innerHTML=tipText(o); tip.style.left=e.clientX+'px'; tip.style.top=e.clientY+'px'; } else tip.hidden=true;
});
renderer.domElement.addEventListener('pointerleave', ()=>{ tip.hidden=true; });
renderer.domElement.addEventListener('pointerup', e=>{
  if(!downAt) return; const d=Math.hypot(e.clientX-downAt[0], e.clientY-downAt[1]); downAt=null;
  if(d>6) return;
  ptr.set(e.clientX/innerWidth*2-1, -(e.clientY/innerHeight)*2+1);
  ray.setFromCamera(ptr,camera);
  const h = ray.intersectObjects(pickables,false)[0];
  if(h) select(objFromHit(h)); else closeCard();
});

/* camera tween */
let tween=null;
function flyTo(pos,tgt,dur=1.4){ tween={p0:camera.position.clone(), t0:controls.target.clone(), p1:pos.clone(), t1:tgt.clone(), s:performance.now(), d:reduce?0.01:dur*1000}; }
const ease = t=> t<.5 ? 4*t*t*t : 1-Math.pow(-2*t+2,3)/2;
function worldPos(obj){ const v=new THREE.Vector3(); obj.getWorldPosition(v); return v; }
function focusFor(o){
  const off = innerWidth>720 ? 1 : 0; // shift view so the card doesn't cover the target
  if(o.kind==='tower'){ const t=towers[o.id]; const p=worldPos(t.group); const tgt=p.clone(); tgt.y+=t.height*.5;
    const dir = p.clone().setY(0).normalize(); const side = new THREE.Vector3(-dir.z,0,dir.x);
    const dist = 12 + t.height*1.1;
    return [tgt.clone().add(dir.multiplyScalar(dist*.85)).add(new THREE.Vector3(0,dist*.55,0)).add(side.multiplyScalar(dist*.35*off)), tgt]; }
  if(o.kind==='island'){ const isl=islands.find(i=>i.name===o.id); const p=isl.group.position.clone(); const dir=p.clone().setY(0).normalize();
    const dist = isl.radius*2.4+12; const side=new THREE.Vector3(-dir.z,0,dir.x);
    return [p.clone().add(dir.multiplyScalar(dist)).add(new THREE.Vector3(0,dist*.7,0)).add(side.multiplyScalar(dist*.3*off)), p.clone().add(new THREE.Vector3(0,3,0))]; }
  if(o.kind==='core' || o.kind==='level'){ return [new THREE.Vector3(off*14, 22, 34), new THREE.Vector3(0,4,0)]; }
  return [HOME.pos, HOME.tgt];
}

/* ---------- card ---------- */
const card=document.getElementById('card'), cK=document.getElementById('cKicker'), cT=document.getElementById('cTitle'), cL=document.getElementById('cLede'), cB=document.getElementById('cBody');
document.getElementById('close').onclick = closeCard;
addEventListener('keydown', e=>{ if(e.key==='Escape') closeCard(); });

function select(o, extra){
  if(!o) return;
  if(selected && keyOf(selected)!==keyOf(o)) setGlow(selected,false);
  selected=o; setGlow(o,true);
  const [p,t]=focusFor(o); flyTo(p,t);
  render(o, extra);
  card.classList.add('open'); cB.scrollTop=0;
}
function closeCard(){ card.classList.remove('open'); if(selected){ setGlow(selected,false); selected=null; } }

const statBox = (n,l)=>`<div class="stat"><div class="n">${n}</div><div class="l">${l}</div></div>`;
function mixBar(a){
  const seg = MORDER.filter(m=>a.m[m]).map((m,i)=>`<span style="width:${pct(a.m[m],a.n)}%;background:${COL[m]};animation-delay:${i*.08}s"></span>`).join('');
  const key = MORDER.map(m=>`<span><i style="background:${COL[m]}"></i>${MLABEL[m]} <em>${fmt(a.m[m])}</em> · ${pct(a.m[m],a.n).toFixed(1)}%</span>`).join('');
  return `<div class="sec"><h3>How these courses land at Kean</h3><div class="mix">${seg}</div><div class="mixkey">${key}</div></div>`;
}
function barList(title, entries, color, clickKind){
  const max = Math.max(...entries.map(e=>e[1]),1);
  const rows = entries.map(([k,v,label],i)=>{
    const tag = clickKind ? 'button' : 'div';
    const attr = clickKind ? ` data-kind="${clickKind}" data-id="${esc(k)}"` : '';
    return `<${tag} class="bar"${attr}><span class="k" title="${esc(label||k)}">${esc(label||k)}</span><span class="track"><b style="width:${100*v/max}%;background:${typeof color==='function'?color(k):color};animation-delay:${i*.04}s"></b></span><span class="v">${fmt(v)}</span></${tag}>`;
  }).join('');
  return `<div class="sec"><h3>${title}</h3><div class="bars">${rows}</div></div>`;
}
function levelBars(a){
  const e = ['UG','GR','DR'].filter(l=>a.lv[l]).map(l=>[l,a.lv[l],LV[l]]);
  return barList('By academic level', e, k=>({UG:'#5cc8ff',GR:'#9fb4ff',DR:'#ff7a9c'})[k], 'level');
}
function topDest(a, n=6){
  const e = Object.entries(a.dest).sort((x,y)=>y[1]-x[1]).slice(0,n).map(([k,v])=>[k,v, k + (k.endsWith('X')?' (elective)':'')]);
  return barList('Top Kean destination codes', e, k=>k.endsWith('X')?COL.elective:COL.direct);
}
function courseRow(c){
  const k = [c.k1,c.k2].filter(Boolean).join(' + ');
  return `<button class="crow" data-course="${c.i}"><i style="background:${COL[c.m]}"></i><span class="cc">${esc(c.c)}</span><span class="ct">${esc(c.t)}<small>→ ${esc(k)} · ${c.cr} cr · ${c.lv}${c.ct==='TD'?' · developmental':''}</small></span></button>`;
}
function coursesBlock(list){
  const f = ['all',...MORDER.filter(m=>list.some(c=>c.m===m))];
  return `<div class="sec"><h3>All ${fmt(list.length)} equivalencies</h3><div class="filters">${f.map((m,i)=>`<button data-f="${m}" class="${i?'':'on'}">${m==='all'?'All':MLABEL[m]}</button>`).join('')}</div><div class="courses" id="clist">${list.map(courseRow).join('')}</div></div>`;
}
function wire(list){
  cB.querySelectorAll('[data-kind]').forEach(b=>b.onclick=()=>select({kind:b.dataset.kind, id:b.dataset.id}));
  cB.querySelectorAll('[data-course]').forEach(b=>b.onclick=()=>openCourse(C[+b.dataset.course]));
  cB.querySelectorAll('[data-f]').forEach(b=>b.onclick=()=>{
    cB.querySelectorAll('[data-f]').forEach(x=>x.classList.toggle('on',x===b));
    const f=b.dataset.f; const el=document.getElementById('clist');
    el.innerHTML = list.filter(c=>f==='all'||c.m===f).map(courseRow).join('');
    el.querySelectorAll('[data-course]').forEach(x=>x.onclick=()=>openCourse(C[+x.dataset.course]));
  });
}

function render(o, extra){
  if(o.kind==='core'){
    cK.textContent='Kean core · whole agreement';
    cT.textContent='All NJCU → Kean equivalencies';
    cL.textContent=`June 2026 equivalency table. ${fmt(ALL.codes.size)} distinct NJCU course codes across ${SUBS.length} NJCU subjects, landing in ${Object.keys(ALL.dest).length} Kean subject codes.`;
    const fams = famOrder.map(f=>[f, byFam[f].length]);
    cB.innerHTML = `<div class="stats">${statBox(fmt(ALL.n),'Equivalency rules')}${statBox(pct(ALL.m.direct,ALL.n).toFixed(1)+'%','Direct match')}${statBox(fmt(ALL.m.elective),'Elective credit')}${statBox(fmt(ALL.njcuCr),'NJCU credits')}${statBox(fmt(ALL.dev),'Developmental')}${statBox(fmt(ALL.gain),'Gain credit at Kean')}</div>
      ${mixBar(ALL)}${levelBars(ALL)}${barList('Subject families (islands)', fams, '#8fb2ff', 'island')}${topDest(ALL,8)}
      <div class="note">“Elective credit” means the Kean equivalent is a generic code ending in X (for example FEX*1000 or ENGX*1003) rather than a named Kean course. “Gain credit” counts rules where the Kean credits add up to more than the NJCU credits.</div>`;
    wire([]);
  }
  else if(o.kind==='island'){
    const list=byFam[o.id], a=agg(list);
    cK.textContent='Island · subject family';
    cT.textContent=o.id;
    cL.textContent=`${Object.keys(a.subs).length} NJCU subjects grouped here. Click a subject to fly to its tower.`;
    const subs = Object.entries(a.subs).sort((x,y)=>y[1]-x[1]);
    cB.innerHTML = `<div class="stats">${statBox(fmt(a.n),'Equivalencies')}${statBox(pct(a.m.direct,a.n).toFixed(0)+'%','Direct match')}${statBox(fmt(a.njcuCr),'NJCU credits')}</div>
      ${mixBar(a)}${barList('NJCU subjects (towers)', subs, '#8fb2ff', 'tower')}${levelBars(a)}${topDest(a)}`;
    wire(list);
  }
  else if(o.kind==='tower'){
    const list=bySub[o.id], a=towers[o.id].st;
    const rank = SUBS.slice().sort((x,y)=>bySub[y].length-bySub[x].length).indexOf(o.id)+1;
    cK.innerHTML=`Tower · NJCU subject · <span style="color:var(--ink)">${esc(P2F[o.id])}</span>`;
    cT.textContent=o.id;
    cL.textContent=`#${rank} of ${SUBS.length} NJCU subjects by number of equivalencies. Tower height is course count; colors stack direct, two-course, then elective.`;
    cB.innerHTML = `<div class="stats">${statBox(fmt(a.n),'Equivalencies')}${statBox(pct(a.m.direct,a.n).toFixed(0)+'%','Direct match')}${statBox(fmt(a.m.elective),'Elective credit')}${statBox(fmt(a.njcuCr),'NJCU credits')}${statBox(fmt(a.keanCr),'Kean credits')}${statBox(fmt(a.codes.size),'Unique codes')}</div>
      ${mixBar(a)}${levelBars(a)}${topDest(a)}${coursesBlock(list)}`;
    wire(list);
  }
  else if(o.kind==='level'){
    const list=C.filter(c=>c.lv===o.id), a=agg(list);
    cK.textContent='Orbit ring · academic level';
    cT.textContent=LV[o.id];
    cL.textContent=`${pct(a.n,ALL.n).toFixed(1)}% of all equivalencies. Ring thickness around the Kean core reflects this share.`;
    const subs = Object.entries(a.subs).sort((x,y)=>y[1]-x[1]).slice(0,8);
    cB.innerHTML = `<div class="stats">${statBox(fmt(a.n),'Equivalencies')}${statBox(pct(a.m.direct,a.n).toFixed(0)+'%','Direct match')}${statBox(fmt(a.njcuCr),'NJCU credits')}</div>
      ${mixBar(a)}${barList('Top NJCU subjects at this level', subs, '#8fb2ff', 'tower')}${topDest(a)}${list.length<=60?coursesBlock(list):''}`;
    wire(list);
  }
  else if(o.kind==='match'){
    const list=C.filter(c=>c.m===o.id), a=agg(list);
    const share = SUBS.map(s=>[s, bySub[s].filter(c=>c.m===o.id).length]).filter(e=>e[1]).sort((x,y)=>y[1]-x[1]).slice(0,10);
    const desc = {direct:'The NJCU course maps to one named Kean course.', split:'The NJCU course maps to two Kean courses, often a lecture plus lab, or a named course plus elective credit.', elective:'The NJCU course maps to generic Kean elective credit (a code ending in X) rather than a named course.'};
    cK.textContent='Legend · match type';
    cT.innerHTML=`<span style="color:${COL[o.id]}">${MLABEL[o.id]}</span>`;
    cL.textContent=desc[o.id]+' Towers now show only this layer brightly.';
    cB.innerHTML = `<div class="stats">${statBox(fmt(a.n),'Equivalencies')}${statBox(pct(a.n,ALL.n).toFixed(1)+'%','Share of all')}${statBox(fmt(Object.keys(a.subs).length),'NJCU subjects')}</div>
      ${barList('NJCU subjects with the most', share, COL[o.id], 'tower')}${levelBars(a)}${topDest(a)}`;
    wire(list);
  }
  else if(o.kind==='course'){
    const c=extra;
    cK.innerHTML=`Course · <span style="color:var(--ink)">${esc(c.p)}</span> · ${esc(P2F[c.p])}`;
    cT.textContent=c.c;
    cL.textContent=c.t;
    const nodes = [[c.k1,c.kc1],[c.k2,c.kc2]].filter(x=>x[0]).map(([k,cr])=>`<div class="node"><div class="who">Kean</div><div class="cd" style="color:${kSub(k).endsWith('X')?COL.elective:COL.direct}">${esc(k)}</div><div class="cr">${cr} credit${cr==1?'':'s'}${kSub(k).endsWith('X')?' · elective':''}</div></div>`).join('<div style="text-align:center;color:var(--ink-faint);font:600 12px var(--mono)">+</div>');
    const others = C.filter(x=>x.c===c.c && x.i!==c.i);
    cB.innerHTML = `<div class="flow"><div class="node"><div class="who">NJCU</div><div class="cd">${esc(c.c)}</div><div class="cr">${c.cr} credit${c.cr==1?'':'s'}</div></div><div class="arrow">→</div><div style="display:flex;flex-direction:column;gap:6px;min-width:0">${nodes}</div></div>
      <div><span class="pill" style="color:${COL[c.m]}">${MLABEL[c.m].toUpperCase()}</span><span class="pill" style="color:#9fb4ff">${LV[c.lv].toUpperCase()}</span>${c.ct==='TD'?`<span class="pill" style="color:${COL.dev}">DEVELOPMENTAL</span>`:''}</div>
      ${c.diff? `<div class="note">Credit difference: Kean awards ${c.diff>0?'+':''}${c.diff} credit${Math.abs(c.diff)==1?'':'s'} relative to NJCU.</div>`:''}
      ${others.length? `<div class="sec"><h3>Other rules for ${esc(c.c)}</h3><div class="courses">${others.map(courseRow).join('')}</div></div>`:''}
      <button class="btn" data-kind="tower" data-id="${esc(c.p)}">Open the ${esc(c.p)} tower →</button>`;
    wire([]);
  }
}
function openCourse(c){
  if(selected && selected.kind!=='tower') setGlow(selected,false);
  const o={kind:'tower', id:c.p}; setGlow(o,true); selected=o;
  const [p,t]=focusFor(o); flyTo(p,t);
  render({kind:'course'}, c); card.classList.add('open'); cB.scrollTop=0;
}

/* legend chips (clickable filters) */
const legend=document.getElementById('legend');
MORDER.forEach(m=>{
  const b=document.createElement('button'); b.className='chip'; b.style.color=COL[m];
  b.innerHTML=`<i style="background:${COL[m]}"></i><span style="color:var(--ink)">${MLABEL[m]}</span><b>${fmt(ALL.m[m])}</b>`;
  b.onclick=()=>{ filterM = filterM===m ? null : m; legend.querySelectorAll('.chip').forEach(x=>x.classList.toggle('on', x===b && filterM===m)); applyFilter(); if(filterM) select({kind:'match', id:m}); };
  legend.appendChild(b);
});
const coreChip=document.createElement('button'); coreChip.className='chip'; coreChip.style.color='#5cc8ff';
coreChip.innerHTML=`<i style="background:#2f8cff"></i><span style="color:var(--ink)">Kean core</span><b>${fmt(ALL.n)}</b>`;
coreChip.onclick=()=>select({kind:'core'}); legend.appendChild(coreChip);
function applyFilter(){
  Object.values(towers).forEach(t=>t.segs.forEach(s=>{
    const on = !filterM || s.userData.seg===filterM;
    s.material.opacity = on?1:.12; s.material.transparent = !on; s.userData.baseEI = on ? (filterM?.9:.32) : .02;
    s.material.emissiveIntensity = s.userData.baseEI; s.material.needsUpdate = true;
  }));
  sMat.opacity = 1;
  streams.forEach((p,i)=>{ const c=new THREE.Color(COL[p.m]); const k=(!filterM||p.m===filterM)?1:.08; sCol.set([c.r*k,c.g*k,c.b*k],i*3); });
  sGeo.attributes.color.needsUpdate=true;
}

/* search */
const q=document.getElementById('q'), res=document.getElementById('results');
q.addEventListener('input', ()=>{
  const s=q.value.trim().toLowerCase();
  if(s.length<2){ res.hidden=true; return; }
  const hits=C.filter(c=> c.c.toLowerCase().includes(s) || c.t.toLowerCase().includes(s) || String(c.k1).toLowerCase().includes(s) || String(c.k2||'').toLowerCase().includes(s)).slice(0,12);
  res.innerHTML = hits.length ? hits.map(c=>`<button data-i="${c.i}"><span class="code">${esc(c.c)}</span><span>${esc(c.t)}</span><span class="sub">→ ${esc([c.k1,c.k2].filter(Boolean).join(' + '))} · ${c.lv}</span></button>`).join('') : `<button disabled><span class="code">—</span><span>No match. Try a code like ACCT251 or a word like “Yoga”.</span></button>`;
  res.hidden=false;
  res.querySelectorAll('[data-i]').forEach(b=>b.onclick=()=>{ res.hidden=true; q.blur(); openCourse(C[+b.dataset.i]); });
});
q.addEventListener('keydown', e=>{ if(e.key==='Enter'){ const b=res.querySelector('[data-i]'); b&&b.click(); } });
document.addEventListener('pointerdown', e=>{ if(!document.getElementById('search').contains(e.target)) res.hidden=true; });

/* buttons */
let touring=false;
const tourBtn=document.getElementById('tour');
function stopTour(){ touring=false; controls.autoRotate=false; tourBtn.textContent='Auto-orbit'; }
tourBtn.onclick=()=>{ touring=!touring; controls.autoRotate=touring; controls.autoRotateSpeed=0.6; tourBtn.textContent=touring?'Stop orbit':'Auto-orbit'; };
document.getElementById('reset').onclick=()=>{ closeCard(); filterM=null; legend.querySelectorAll('.chip').forEach(x=>x.classList.remove('on')); applyFilter(); flyTo(HOME.pos,HOME.tgt); };

/* ---------- loop ---------- */
const clock=new THREE.Clock(); let T=0;
const start=performance.now();
flyTo(HOME.pos,HOME.tgt, 3.2);
requestAnimationFrame(()=>document.getElementById('loading').classList.add('gone'));

function animate(){
  requestAnimationFrame(animate);
  const dt=Math.min(clock.getDelta(),0.05); T+=dt;
  const since=(performance.now()-start)/1000;

  if(tween){ const k=Math.min(1,(performance.now()-tween.s)/tween.d), e=ease(k);
    camera.position.lerpVectors(tween.p0,tween.p1,e); controls.target.lerpVectors(tween.t0,tween.t1,e); if(k>=1) tween=null; }

  const amp = reduce?0:1;
  islands.forEach(isl=>{ isl.group.position.y = isl.base.y + Math.sin(T*0.45+isl.phase)*0.7*amp; isl.group.rotation.y = Math.sin(T*0.12+isl.phase)*0.05*amp; });
  core.rotation.y += dt*0.15*amp;
  coreMesh.rotation.x += dt*0.2*amp; coreShell.rotation.y -= dt*0.25*amp;
  coreMesh.scale.setScalar(1+Math.sin(T*1.6)*0.035*amp);
  rings.forEach((r,i)=>{ r.rotation.z += dt*(0.2+i*0.08)*(i%2?-1:1)*amp; r.userData.hit.rotation.copy(r.rotation); });
  stars.rotation.y += dt*0.004*amp;

  // tower growth intro + hover lift
  Object.entries(towers).forEach(([s,t])=>{
    if(!reduce){ const k=Math.min(1,Math.max(0,(since-0.9-t.delay)/1.1)); const e=1-Math.pow(1-k,3); const target = (hovered && hovered.kind==='tower' && hovered.id===s) || (selected && selected.kind==='tower' && selected.id===s) ? 1.06 : 1;
      t.group.scale.y += ((e*target)-t.group.scale.y)*0.18; }
    const d = camera.position.distanceTo(worldPos(t.group));
    t.label.material.opacity = THREE.MathUtils.clamp((95-d)/30,0,1);
    t.label.scale.y = 0.62/Math.max(t.group.scale.y,.05); // keep labels undistorted
  });

  // streams
  for(let i=0;i<streams.length;i++){ const p=streams[i]; p.t += dt*p.sp*amp; if(p.t>1) p.t-=1;
    bez(p.isl,p.t,_v,p.off*4); _v.x += Math.sin(T*2+p.wob)*0.25; _v.z += Math.cos(T*2+p.wob)*0.25;
    sPos[i*3]=_v.x; sPos[i*3+1]=_v.y; sPos[i*3+2]=_v.z; }
  sGeo.attributes.position.needsUpdate=true;
  lineObjs.forEach(({line,isl})=>{ const a=line.geometry.attributes.position; for(let j=0;j<a.count;j++){ bez(isl,j/(a.count-1),_v); a.setXYZ(j,_v.x,_v.y,_v.z);} a.needsUpdate=true; });

  // island HTML labels
  islands.forEach(isl=>{ const p=isl.group.position.clone(); p.y += 4.5; p.project(camera);
    const vis = p.z<1 && Math.abs(p.x)<1.1 && Math.abs(p.y)<1.1;
    isl.labelEl.style.display = vis?'block':'none';
    if(vis){ isl.labelEl.style.left=((p.x+1)/2*innerWidth)+'px'; isl.labelEl.style.top=((1-p.y)/2*innerHeight)+'px';
      const d=camera.position.distanceTo(isl.group.position); isl.labelEl.style.opacity = d<22 ? .25 : 1; } });

  controls.update();
  composer.render();
}
animate();

addEventListener('resize', ()=>{ camera.aspect=innerWidth/innerHeight; camera.updateProjectionMatrix(); renderer.setSize(innerWidth,innerHeight); composer.setSize(innerWidth,innerHeight); bloom.setSize(innerWidth,innerHeight); });
</script>
